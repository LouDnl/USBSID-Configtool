{:paths     ["src" "resources"]
 ; Specify repos as fix for potential missing versions in classpath
 :mvn/repos {"central" {:url "https://repo1.maven.org/maven2/"} ; Fix found here: https://github.com/juxt/pack.alpha/issues/7
             "clojars" {:url "https://repo.clojars.org/"}       ; No need to explain here
             "jitpack" {:url "https://jitpack.io"}}             ; Jitpack is to import github repositories
 :deps      {org.clojure/clojure                   {:mvn/version "1.12.5"} ; Parens
             cljfx/cljfx                           {:mvn/version "1.10.8"} ; GUI shizzle (https://github.com/cljfx/cljfx)
             cljfx/css                             {:mvn/version "1.1.0"}  ; Pretty GUI shizzle (https://github.com/cljfx/css)
             org.usb4java/usb4java                 {:mvn/version "1.3.0"}  ; Required for USB driver (https://github.com/usb4java/usb4java)
             org.usb4java/usb4java-javax           {:mvn/version "1.3.0"}  ; Required for USB driver (https://github.com/usb4java/usb4java-javax)
             usbsid/usbsid-usb-driver-library-java {:mvn/version "1.1"}}   ; USBSID-Pico driver (I made that, wow!)
 :aliases
 {; clj -M:run-m
  :run-m {:main-opts ["-m" "usbsid.core"]
          :jvm-opts  ["--enable-native-access=ALL-UNNAMED"
                      "--sun-misc-unsafe-memory-access=allow"]}
  ; clj -X:run-x
  :run-x {:ns-default usbsid.core
          :exec-fn    -main
          :exec-args  {:name "Clojure"}
          :jvm-opts   ["--enable-native-access=ALL-UNNAMED"
                       "--sun-misc-unsafe-memory-access=allow"]}
  :dev   {:extra-paths ["dev/src" "dev/resources"]
          :extra-deps  {; app related testing tools
                        io.github.cljfx/dev                       {:mvn/version "1.10.6.44"}  ; GUI shizzle for dummies (https://github.com/cljfx/dev)
                        ; deps for development testing with Clojure tools
                        org.clojure/tools.deps                    {:mvn/version "0.30.1611"}, ; Functional API for transitive dependency graph expansion and the creation of classpaths (https://github.com/clojure/tools.deps)
                        org.clojure/tools.namespace               {:mvn/version "1.5.1"},     ; Tools for managing namespaces in Clojure (https://github.com/clojure/tools.namespace)
                        ; deps for development testing with Babashka
                        borkdude/babashka                         {:mvn/version "0.2.6"},     ; Native Clojure interpreter for scripting with fast startup (https://github.com/babashka/babashka)
                        babashka/fs                               {:mvn/version "0.5.33"},    ; File system utilities (https://github.com/babashka/babashka)
                        babashka/babashka.pods                    {:mvn/version "0.2.0"},     ; Expose namespaces with vars to babashka or a JVM (https://github.com/babashka/pods)
                        ; deps for debugging
                        djblue/portal                             {:mvn/version "0.64.1"},    ; A clojure tool to navigate through your data (https://github.com/djblue/portal)
                        com.github.jpmonettas/flow-storm-dbg      {:mvn/version "3.7.5"},     ; Tracing debugger for Clojure and Clojure(Script) (https://github.com/jpmonettas/flow-storm-debugger)
                        com.clojure-goes-fast/clj-async-profiler  {:mvn/version "1.7.0"},     ; Embedded high-precision performance profiler for Clojure (https://github.com/clojure-goes-fast/clj-async-profiler)
                        com.clojure-goes-fast/clj-java-decompiler {:mvn/version "0.3.7"},     ; integrated Clojure-to-Java decompiler for the REPL (https://github.com/clojure-goes-fast/clj-java-decompiler)
                        }
          :jvm-opts    ["--enable-native-access=ALL-UNNAMED"
                        "--sun-misc-unsafe-memory-access=allow"
                        "-Dusbsid-dev-env=True"]}
  :build {:deps       {io.github.clojure/tools.build
                       {:mvn/version "0.10.14"}}
          :jvm-opts   ["--enable-native-access=ALL-UNNAMED"
                       "--sun-misc-unsafe-memory-access=allow"
                       #_"-Dcljfx.skip-javafx-initialization=true"]
          :ns-default build}
  :test  {:extra-paths ["test"]
          :extra-deps  {org.clojure/test.check               {:mvn/version "1.1.3"}
                        io.github.cognitect-labs/test-runner {:git/tag "v0.5.1"
                                                              :git/sha "dfb30dd"}}}}}
